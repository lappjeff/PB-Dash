# ---------------------------------------------------------------------------
# PB Sales Intelligence. Copy to .env.local for local development.
# Leave everything blank to run in DEMO mode (embedded database + fictional data).
# Never commit real values.
# ---------------------------------------------------------------------------

# Neon PostgreSQL. Use the POOLED connection string on Vercel. Setting this switches
# the app to live mode, which requires Clerk.
DATABASE_URL=

# Precise Builder REST API (Settings -> Integrations -> REST API in PB).
# Base URL is your account address including the account id, e.g. https://app.precisebuilder.com/t1234abcd
PRECISE_BUILDER_API_KEY=
PRECISE_BUILDER_BASE_URL=
# Webhook endpoint signing secret (whsec_...). Comma-separate several if you register more than one endpoint.
PRECISE_BUILDER_WEBHOOK_SECRET=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Comma-separated emails that become ADMIN on sign-in.
ADMIN_EMAILS=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". At least 16 random characters.
CRON_SECRET=

NEXT_PUBLIC_APP_URL=

# Company-local time zone for reporting periods (IANA name). Default America/New_York.
COMPANY_TIMEZONE=America/New_York

# Set to "true" only to run a production build without a database, using demo data.
DEMO_MODE=

# Durable background processing uses the database itself (webhook_events table +
# Vercel Cron); no extra queue service or variables are required.
